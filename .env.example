NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sih_scholarship
DB_USER=sih_user
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# AI verification service (Member 4)
AI_SERVICE_URL=http://localhost:6000/verify-document
AI_SERVICE_TIMEOUT_MS=8000

# CORS
CORS_ORIGIN=*
